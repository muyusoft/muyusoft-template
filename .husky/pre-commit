branch=$(git branch --show-current)

# En detached HEAD (rebase, bisect) no hay rama que validar.
if [ -n "$branch" ]; then
  if [ "$branch" = "main" ]; then
    echo ""
    echo "  ERROR: no se commitea directo a main."
    echo ""
    echo "    Crea una rama primero:"
    echo "      git checkout -b feat/mi-cambio"
    echo ""
    exit 1
  fi

  if ! echo "$branch" | grep -qE '^(feat|fix|refactor|chore|docs|test|perf|ci)/([A-Z]+-[0-9]+-)?[a-z0-9]+(-[a-z0-9]+)*$'; then
    echo ""
    echo "  ERROR: nombre de rama invalido -> $branch"
    echo ""
    echo "    Formato: <type>/<descripcion-en-kebab-case>"
    echo "    Types:   feat fix refactor chore docs test perf ci"
    echo "    Ejemplo: feat/user-profile-screen"
    echo ""
    exit 1
  fi

  if [ "${#branch}" -gt 50 ]; then
    echo ""
    echo "  ERROR: rama demasiado larga -> ${#branch} caracteres (maximo 50)"
    echo ""
    exit 1
  fi
fi

lint-staged
